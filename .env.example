POSTGRES_DB=seo_demo
POSTGRES_USER=seo_demo
POSTGRES_PASSWORD=seo_demo_local_only
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Optional Google Search Console connection.
GSC_SITE_CODE=my_site
GSC_SITE_NAME=My Site
GSC_PROPERTY=sc-domain:example.com
GSC_CREDENTIALS_FILE=/app/credentials/gsc-service-account.json
GSC_LOOKBACK_DAYS=7
GSC_LAG_DAYS=3
GSC_SEARCH_TYPE=web
GSC_INTERVAL_SECONDS=86400

# Local Metabase dashboard. These defaults are for localhost only.
WAREHOUSE_READER_USER=seo_reader
WAREHOUSE_READER_PASSWORD=seo_reader_local_only
METABASE_PORT=3000
METABASE_DB_NAME=metabase_app
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=metabase_app_local_only
METABASE_ADMIN_EMAIL=admin@example.local
METABASE_ADMIN_PASSWORD=local_admin_2026
METABASE_SESSION_SECRET=local_session_secret_2026
